# --- Mode ---
PAPER_TRADING_MODE=true
DRY_RUN=false
BROKER=kraken
ACCOUNT_EQUITY=3000
SYMBOLS=BTC-USD,ETH-USD,SOL-USD,LINK-USD,XCN-USD
SYMBOL_MODE=ALLOWLIST
MAJORS_ONLY=true
UNIVERSE_STOCKS=false
ALLOW_PAPER_SHORTS=false

# --- Kraken (PLACEHOLDERS ONLY) ---
KRAKEN_API_KEY=YOUR_KRAKEN_API_KEY
KRAKEN_API_SECRET=YOUR_KRAKEN_API_SECRET
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com/v2

# Leave unused brokers empty
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Isolated Instance #2 paths ---
SQLITE_PATH=data/trading_bot_2.db
PAPER_BOOK_PATH=data/paper_book_2.json
ACTIVE_PARAMS_PATH=data/active_params_2.json
SQLITE_BACKUP_DIR=data/backups_2
TRADES_DB_PATH=data/trades.db

# --- Risk / strategy (Tier-1 Winning Formula defaults) ---
STRATEGY_MODE=volume_sweet_spot
MAX_NOTIONAL_PER_TRADE_USD=750
MAX_TOTAL_EXPOSURE_USD=3000
MAX_CONCURRENT_POSITIONS=3
ENTRY_THRESHOLD=60
TRADE_PROFILE=medium
STOP_LOSS_PROFILE=medium
WINNING_FORMULA=true
# PHD_MODE=false  # Professional High Discipline ops pack + WEAK formula soft entry gate
# PHD_MAX_DD_PCT=8.0  # When PHD on, pause new entries if session peak DD ≥ this %
# QUANT_METRICS_ON_STATUS=true  # Append compact quant: line on /status
CIRCUIT_BREAKER_ENABLED=true
TRAIL_FEE_BUFFER_PCT=0.0125
ELITE_FEE_LOCK_ARM_PCT=0.012
TP1_FRACTION=0
TAKER_FEE_RATE=0.008
MAKER_FEE_RATE=0.004
POST_ONLY=true
ELITE_RISK_ENABLED=true
BTC_REGIME_ENABLED=true
TOD_GATE_ENABLED=true
DISABLE_TOD_GATE=false
CAPS_CUSTOM_LOCK=false
MAX_SPREAD_PCT=0.002

# --- Telegram (PLACEHOLDERS) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_COMMANDS_ENABLED=true

# --- Optional LLM / Grok (official xAI API only) ---
USE_LLM=false
XAI_API_KEY=YOUR_XAI_API_KEY
XAI_BASE_URL=https://api.x.ai/v1

# --- Anti-abuse / API pacing ---
# Min seconds between public Kraken REST calls (DataFeed + broker ticker)
KRAKEN_PUBLIC_MIN_INTERVAL=0.2
# Max concurrent OHLC fetches during a scan
OHLC_FETCH_CONCURRENCY=5
# Trip rate-limit breaker after N consecutive 429/503s; cooldown seconds
RATE_LIMIT_TRIP_AFTER=2
RATE_LIMIT_COOLDOWN_SECONDS=120
# Extra random jitter added to AGENT_POLL_SECONDS each loop
AGENT_POLL_JITTER_SECONDS=0.15

LOG_LEVEL=INFO
AGENT_POLL_SECONDS=1
OHLC_CACHE_SECONDS=20
AGENT_POLL_LIVE_SECONDS=4
KRAKEN_PUBLIC_MIN_INTERVAL_LIVE=0.35
OHLC_CACHE_LIVE_SECONDS=15
LIVE_MAX_ORDERS_PER_MINUTE=6
API_RISK_PAUSE_ON_HIGH=true
API_RISK_PAUSE_ON_MEDIUM=false

# --- Backup Telegram (New Guy mirror for critical alerts) ---
# Prefer leaving unset: on start, Notifier loads New Guy token from
# /workspace/The-New-Guy-Cruz/.env (tokens stay separate — never merge).
# BACKUP_TELEGRAM_BOT_TOKEN=
# BACKUP_TELEGRAM_CHAT_ID=6949546419
# NEWGUY_TELEGRAM_BOT_TOKEN=
# NEWGUY_TELEGRAM_CHAT_ID=6949546419

# --- SMS / Twilio (optional; no-op until all four set) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# --- Email stub (optional; no-op until configured) ---
# BACKUP_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
